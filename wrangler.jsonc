{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "beezyworks-accounts",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	// Served at auth.baderech.app (the zone baderech.app must be on Cloudflare).
	"routes": [{ "pattern": "auth.baderech.app", "custom_domain": true }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "beezyworks-accounts",
			"database_id": "454af5b4-6a1e-4830-9014-fcde9b8b4c86",
			"migrations_dir": "migrations"
		}
	],
	// Non-secret config. Secrets (BETTER_AUTH_SECRET, RESEND_API_KEY, GOOGLE_*,
	// APPLE_TEAM_ID/KEY_ID/PRIVATE_KEY) are set with `wrangler secret put`.
	"vars": {
		"BETTER_AUTH_URL": "https://auth.baderech.app",
		"EMAIL_FROM": "Baderech <noreply@baderech.app>",
		"TRUSTED_ORIGINS": "mishnaapp://,https://mishna.baderech.app,siddurone://,https://siddur.baderech.app,https://tefila.baderech.app,https://siddur.one,https://beitecha.baderech.app",
		"COOKIE_DOMAIN": "baderech.app",
		"APPLE_SERVICES_ID": "com.beezyworks.accounts",
		"APPLE_APP_BUNDLE_IDS": "com.beezyworks.siddurone"
	}
}
